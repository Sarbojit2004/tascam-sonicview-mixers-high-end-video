{
  "name": "india-independence-day-80th-reel",
  "version": "1.0.0",
  "private": true,
  "description": "A 60-second vertical reel for India's 80th Independence Day (15 August 2026). Heritage and diversity storytelling in original vector motion graphics, with a fully synthesized score and SFX palette.",
  "scripts": {
    "studio": "remotion studio",
    "typecheck": "tsc --noEmit",
    "audio": "python3 scripts/gen_audio.py && python3 scripts/audit_audio.py",
    "audit": "python3 scripts/audit_audio.py",
    "stills": "node scripts/stills.mjs",
    "bundlecheck": "node scripts/bundlecheck.mjs",
    "verify": "node scripts/verify_render.mjs out/independence-day-80th-reel.mp4",
    "range": "remotion render Reel out/_range.mp4 --frames=740-1040 --image-format=png --codec=h264 --crf=20 --pixel-format=yuv420p",
    "render": "remotion render Reel out/independence-day-80th-reel.mp4 --image-format=png --codec=h264 --crf=17 --pixel-format=yuv420p --color-space=bt709"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.507",
    "@remotion/cli": "4.0.507",
    "@remotion/renderer": "4.0.507",
    "@remotion/shapes": "4.0.507",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "remotion": "4.0.507"
  },
  "devDependencies": {
    "@ffmpeg-installer/ffmpeg": "1.1.0",
    "@ffprobe-installer/ffprobe": "2.1.2",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "typescript": "5.6.3"
  }
}
